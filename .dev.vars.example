# Copy to .dev.vars for Cloudflare Pages local development. Never commit real values.
ENVIRONMENT=development

# Required model credentials. The gateway always tries DeepSeek first and
# falls back to Kimi only when the DeepSeek attempt is allowed to fall back.
DEEPSEEK_API_KEY=
KIMI_API_KEY=

# Official defaults are built in. Keep these only when local testing needs an override.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3

# Optional in development. Set this in production unless a supported
# AI_RATE_LIMITER binding and application authentication are present.
AI_GATEWAY_ACCESS_TOKEN=
AI_GATEWAY_ALLOWED_ORIGINS=http://localhost:4321

# Bind the existing zx-signal D1 database to this Pages Function as LLM_USAGE_DB.
# One Pages Access application protects Risk and supplies the shared browser
# session used by LLM telemetry and the /api/private/* same-origin proxies.
RISK_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
RISK_ACCESS_AUD=

# Optional Pages secret. Map a verified Cloudflare Access service-token Client ID
# to a delegated owner subject and the exact private-route scopes it may use.
# Never place the Cloudflare client secret, CF_Authorization cookie, or a real
# subject value in this file.
ZX_ACCESS_SERVICE_ACTORS=
ZX_ACCESS_ADDITIONAL_SERVICE_ACTORS=

# Optional JSON array of audiences for a separate private debug Access app.
# The normal RISK_ACCESS_AUD is always required as the primary audience.
ZX_PRIVATE_ACCESS_ADDITIONAL_AUDS=
