PUBLIC_RUNTIME_API_BASE=https://runtime-api.zx-dx.xyz
RUNTIME_API_URL=https://runtime-api.zx-dx.xyz

TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=
TAILSCALE_TAILNET=-
TAILSCALE_PUBLIC_DEVICES={}

CODEX_USAGE_API_URL=https://usage.example.com
CODEX_USAGE_API_TOKEN=
CODEX_USAGE_CACHE_TTL=120
CODEX_USAGE_STALE_TTL=21600
CODEX_USAGE_REQUEST_TIMEOUT=8

# Cloudflare Pages AI Gateway. Copy these values to .dev.vars for local use.
# Production keys must remain server-only Cloudflare secrets.
ENVIRONMENT=development
DEEPSEEK_API_KEY=
KIMI_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3
AI_GATEWAY_ACCESS_TOKEN=
AI_GATEWAY_ALLOWED_ORIGINS=http://localhost:4321
# Cloudflare Pages runtime values for the Access-protected Risk review boundary.
RISK_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
RISK_ACCESS_AUD=
