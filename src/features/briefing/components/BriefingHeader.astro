---
import type { DailyBriefing } from "../types";
import { YuragiStaticTitle } from "../../../components/yuragi/YuragiStaticTitle";

interface Props { briefing: DailyBriefing; }
const { briefing } = Astro.props;
const date = new Intl.DateTimeFormat("zh-CN", {
  month: "long",
  day: "numeric",
  weekday: "long",
  timeZone: "Asia/Shanghai",
}).format(new Date(`${briefing.date}T12:00:00+08:00`));
const generatedAt = new Intl.DateTimeFormat("zh-CN", {
  hour: "2-digit",
  minute: "2-digit",
  timeZone: "Asia/Shanghai",
}).format(new Date(briefing.generatedAt));
const generationLabel = {
  model: "模型综合",
  "deterministic-fallback": "确定性降级",
  "legacy-unknown": "历史生成方式未知",
}[briefing.generationMode];
const qualityLabel = {
  passed: "质量通过",
  degraded: "质量降级",
  unknown: "历史质量状态未知",
}[briefing.qualityStatus];
const originLabel = briefing.id === "signal-unavailable"
  ? "API 不可用"
  : `${{ mock: "Mock 预览", fixture: "Fixture", real: "真实候选" }[briefing.dataOrigin]} · ${generationLabel}`;
const baseStatusLabel = { generating: "生成中", ready: "已就绪", partial: "部分完成", failed: "生成失败" }[briefing.status];
const statusLabel = briefing.status === "ready" || briefing.status === "partial"
  ? `${baseStatusLabel} · ${qualityLabel}`
  : baseStatusLabel;
---

<section class="signal-hero" aria-labelledby="signal-title">
  <div class="signal-hero__copy">
    <p class="signal-kicker"><span aria-hidden="true"></span> ZX Signal · {date}</p>
    <div class="section-yuragi-title section-yuragi-title--signal" aria-hidden="true">
      <YuragiStaticTitle client:load text="SIGNAL" size={120} maxWidth={720} hover="outline" motionPreset="section-reveal" className="section-yuragi-title__text" />
    </div>
    <h1 id="signal-title">每天真正值得我关注的变化</h1>
    <p class="signal-deck">{briefing.title}</p>
    <div class="signal-hero__actions">
      <a href="#lead-story">阅读主报道 <span aria-hidden="true">↓</span></a>
      <a href="#briefs-start">浏览今日短讯 <span aria-hidden="true">↘</span></a>
    </div>
  </div>
</section>

<section class="signal-editorial-band" aria-label="今日总编辑摘要">
  <div class="signal-editorial" aria-label="今日总编辑摘要">
    <div class="signal-editorial__visual" aria-hidden="true">
      <div class="signal-orbit signal-orbit--outer"></div>
      <div class="signal-orbit signal-orbit--inner"></div>
      <span></span>
    </div>
    <p class="signal-editorial__label">今日总编辑摘要</p>
    <p class="signal-editorial__summary" data-scrub-summary>{briefing.summary}</p>
    <button class="signal-summary-toggle" type="button" data-summary-toggle aria-expanded="false">展开摘要</button>
    <dl>
      <div><dt>生成</dt><dd>{generatedAt}</dd></div>
      <div><dt>版本</dt><dd>{briefing.promptVersion}</dd></div>
      <div><dt>状态</dt><dd data-briefing-status>{statusLabel}</dd></div>
      <div><dt>数据</dt><dd data-briefing-origin>{originLabel}</dd></div>
    </dl>
  </div>
</section>
