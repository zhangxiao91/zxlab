---
import Layout from "../../layouts/Layout.astro";
import TradingWorkbench from "../../features/trading/TradingWorkbench";
import { parseTradingLocation } from "../../features/trading/route";
import "../../styles/risk.css";
import "../../styles/market-agent.css";

const initialLocation = parseTradingLocation(Astro.url);
---

<Layout title="交易工作台 | zxlab" description="统一的持仓、行情、记录与复盘工作台。" lang="zh-CN">
  <div class="risk-page trading-page">
    <TradingWorkbench client:only="react" initialLocation={initialLocation} />
  </div>
</Layout>
