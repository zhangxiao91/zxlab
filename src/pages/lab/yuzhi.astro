---
const destination = "/lab/yuzi";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={new URL(destination, Astro.site).toString()} />
    <title>余字已迁移 | zxlab</title>
  </head>
  <body>
    <p>正在前往 <a href={destination}>余字</a>。</p>
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination);
    </script>
  </body>
</html>
