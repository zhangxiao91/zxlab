---
import Layout from "../layouts/Layout.astro";
import AnnotationPanel from "../features/briefing/components/AnnotationPanel.astro";
import BriefingHeader from "../features/briefing/components/BriefingHeader.astro";
import BriefingItemCard from "../features/briefing/components/BriefingItemCard.astro";
import BriefingStateView from "../features/briefing/components/BriefingStateView.astro";
import BriefingStats from "../features/briefing/components/BriefingStats.astro";
import WatchWorkspace from "../features/briefing/components/WatchWorkspace.astro";
import { getLatestBriefing } from "../features/briefing/client";
import { resolveLongTermThreads } from "../features/briefing/long-term-threads";
import type { DailyBriefing } from "../features/briefing/types";
import "../styles/briefing.css";

let briefing: DailyBriefing;
try {
  briefing = await getLatestBriefing("ready");
} catch {
  briefing = {
    id: "signal-unavailable",
    date: new Date().toISOString().slice(0, 10),
    status: "failed" as const,
    title: "日报暂时不可用",
    summary: "Signal API 当前未返回可用日报。页面不会用 mock 内容伪装成真实结果。",
    generatedAt: new Date().toISOString(),
    promptVersion: "unavailable",
    dataOrigin: "real" as const,
    generationMode: "model" as const,
    qualityStatus: "degraded" as const,
    stats: { fetched: 0, deduplicated: 0, balanced: 0, synthesized: 0, selected: 0 },
    longTermThreads: [],
    items: [],
  };
}
const resolvedThreads = resolveLongTermThreads(briefing.longTermThreads);
---

<Layout
  title="ZX Signal | zxlab"
  description="每天真正值得我关注的变化，一份可回应、可积累的个人日报。"
  lang="zh-CN"
>
  <main
    class="signal-page"
    data-briefing-state={briefing.status}
    data-briefing-id={briefing.id}
    data-briefing-generated-at={briefing.generatedAt}
    data-briefing-quality-status={briefing.qualityStatus}
  >
    <BriefingHeader briefing={briefing} />

    <aside class="signal-partial" role="status" data-partial-preview hidden>
      <span aria-hidden="true"></span>
      <div><strong>部分来源暂时不可用</strong><p>已交付可以确认的 <span data-partial-count>{briefing.stats.selected}</span> 条内容，其余候选不会在证据不足时补齐。</p></div>
    </aside>

    <BriefingStateView state="generating" hidden />
    <BriefingStateView state="failed" hidden />
    <BriefingStateView state="empty" hidden />

    <div data-ready-content>
        <BriefingStats briefing={briefing} />

        <section class="signal-stream" aria-labelledby="stream-title">
          <div class="signal-stream__intro">
            <p>今日重点</p>
            <h2 id="stream-title">更少噪音，<br />更快判断。</h2>
            <p>选中正文里的任意判断，留下评论、质疑或追踪条件。你的反馈只会先成为候选，不会自动变成长期记忆。</p>
            <div class="signal-reading-tools" aria-label="日报筛选">
              <div class="signal-category-filter" role="group" aria-label="按分类筛选">
                <button type="button" data-category-filter="all" aria-pressed="true">全部</button>
                <button type="button" data-category-filter="ai-engineering" aria-pressed="false">AI</button>
                <button type="button" data-category-filter="zxlab" aria-pressed="false">zxlab</button>
                <button type="button" data-category-filter="markets" aria-pressed="false">Markets</button>
              </div>
              <button class="signal-importance-filter" type="button" data-importance-filter aria-pressed="false">
                只看重要
              </button>
              <p><span data-visible-count>{briefing.items.length}</span> 条可见</p>
            </div>
          </div>
          <div class="signal-stream__items">
            {briefing.items.map((item, index) => <BriefingItemCard item={{ ...item, itemType: item.itemType ?? (index === 0 ? "lead" : "brief") }} index={index} />)}
            <p class="signal-filter-empty" data-filter-empty hidden>当前筛选没有条目。关闭“只看重要”或切换分类即可继续浏览。</p>
          </div>
        </section>

        <section class="signal-threads" aria-labelledby="threads-title" data-long-term-threads data-thread-origin={resolvedThreads.usingDefault ? "default" : "generated"}>
          <div class="signal-threads__heading">
            <p>长期线索 <span data-default-thread-label hidden={!resolvedThreads.usingDefault}>默认线索</span></p>
            <h2 id="threads-title">今天的变化，之后会连成线。</h2>
          </div>
          <div class="signal-accordion" data-thread-list style={`--thread-count: ${resolvedThreads.threads.length}`}>
            {resolvedThreads.threads.map((thread) => (
              <article tabindex="0" data-thread-id={thread.id} data-thread-category={thread.category}>
                <div><h3>{thread.title}</h3><p>{thread.description}</p></div>
                <i aria-hidden="true"></i>
              </article>
            ))}
          </div>
        </section>

        <WatchWorkspace />

        <section class="signal-action" aria-labelledby="signal-action-title">
          <p>本阶段的闭环已经在浏览器内成立</p>
          <h2 id="signal-action-title">阅读，回应，确认什么值得留下。</h2>
          <a href="#stream-title"><span>回到今日重点</span><span aria-hidden="true">↑</span></a>
        </section>
    </div>
  </main>

  <AnnotationPanel slot="overlay" />

  <template slot="overlay" data-watch-confirm-template>
    <section class="watch-confirm" data-watch-confirm hidden aria-labelledby="watch-confirm-title">
      <header><p>持续追踪</p><span>等待确认</span></header>
      <h3 id="watch-confirm-title">先把触发变化的条件说清楚。</h3>
      <label for="watch-condition">追踪条件</label>
      <textarea id="watch-condition" rows="4" maxlength="1000" data-watch-condition required></textarea>
      <p>确认后才会建立跨设备 Watch；这不是 Memory，也不会自动改变长期偏好。</p>
      <button type="button" data-watch-confirm-button><span>确认追踪</span><span aria-hidden="true">↗</span></button>
      <p class="watch-confirm__status" role="status" aria-live="polite" data-watch-confirm-status hidden></p>
    </section>
  </template>

  <script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import {
      getLatestBriefing,
      submitAnnotationStream,
      getMemories,
      getWatches,
      createWatch,
      resolveWatch,
      updateMemoryCandidate,
    } from "../features/briefing/client";
    import { resolveLongTermThreads } from "../features/briefing/long-term-threads";
    import { briefingSessionStore } from "../features/briefing/store";
    import type {
      AnnotationAction,
      AnnotationResponse,
      BriefingItem,
      DailyBriefing,
      MemoryCandidate,
      MemoryScope,
      WatchDossier,
    } from "../features/briefing/types";

    gsap.registerPlugin(ScrollTrigger);

    const previewParam = new URL(window.location.href).searchParams.get("state");
    const previewState = previewParam
      ?? document.querySelector<HTMLElement>("[data-briefing-state]")?.dataset.briefingState
      ?? "ready";
    const supportedStates = ["ready", "generating", "partial", "failed", "empty"];
    const statusLabel = document.querySelector<HTMLElement>("[data-briefing-status]");
    let activeState = supportedStates.includes(previewState) ? previewState : "ready";
    let activeQualityStatus = document.querySelector<HTMLElement>("[data-briefing-quality-status]")
      ?.dataset.briefingQualityStatus ?? "unknown";

    const setPreviewState = (state: string) => {
      activeState = supportedStates.includes(state) ? state : "ready";
      const showReadyContent = activeState === "ready" || activeState === "partial";
      document.querySelector<HTMLElement>("[data-ready-content]")?.toggleAttribute("hidden", !showReadyContent);
      document.querySelector<HTMLElement>("[data-partial-preview]")?.toggleAttribute("hidden", activeState !== "partial");
      document.querySelectorAll<HTMLElement>("[data-preview-state]").forEach((element) => {
        element.toggleAttribute("hidden", element.dataset.previewState !== activeState);
      });
      const baseStatusLabel = {
        ready: "已就绪",
        partial: "部分完成",
        generating: "生成中",
        failed: "生成失败",
        empty: "已扫描",
      }[activeState] ?? "已就绪";
      const qualityLabel = {
        passed: "质量通过",
        degraded: "质量降级",
        unknown: "历史质量状态未知",
      }[activeQualityStatus] ?? "历史质量状态未知";
      if (statusLabel) statusLabel.textContent = activeState === "ready" || activeState === "partial"
        ? `${baseStatusLabel} · ${qualityLabel}`
        : baseStatusLabel;
    };

    setPreviewState(activeState);

    const menu = document.querySelector<HTMLElement>("[data-annotation-menu]");
    const panel = document.querySelector<HTMLElement>("[data-annotation-panel]");
    const scrim = document.querySelector<HTMLElement>("[data-annotation-scrim]");
    const form = document.querySelector<HTMLFormElement>("[data-annotation-form]");
    const result = document.querySelector<HTMLElement>("[data-annotation-result]");
    const selectionOutput = document.querySelector<HTMLElement>("[data-panel-selection]");
    const itemOutput = document.querySelector<HTMLElement>("[data-panel-item]");
    const closeButton = document.querySelector<HTMLButtonElement>("[data-panel-close]");
    const submitLabel = document.querySelector<HTMLElement>("[data-submit-label]");
    const submitError = document.querySelector<HTMLElement>("[data-annotation-error]");
    const commentLabel = document.querySelector<HTMLElement>("[data-comment-label]");
    const briefingPage = document.querySelector<HTMLElement>("[data-briefing-state]");
    let briefingId = document.querySelector<HTMLElement>("[data-briefing-id]")?.dataset.briefingId ?? "";
    const watchConfirmTemplate = document.querySelector<HTMLTemplateElement>("[data-watch-confirm-template]");
    if (result && watchConfirmTemplate && !result.querySelector("[data-watch-confirm]")) {
      result.append(watchConfirmTemplate.content.cloneNode(true));
    }
    const watchConfirm = result?.querySelector<HTMLElement>("[data-watch-confirm]");
    const watchCondition = watchConfirm?.querySelector<HTMLTextAreaElement>("[data-watch-condition]");
    const watchConfirmButton = watchConfirm?.querySelector<HTMLButtonElement>("[data-watch-confirm-button]");
    const watchConfirmStatus = watchConfirm?.querySelector<HTMLElement>("[data-watch-confirm-status]");
    let watches: WatchDossier[] = [];
    const session = briefingSessionStore.load();
    getMemories().then(({ candidates }) => {
      if (candidates.length === 0) return;
      const byId = new Map(candidates.map((candidate) => [candidate.id, candidate]));
      session.memoryCandidates = session.memoryCandidates.map((candidate) => byId.get(candidate.id) ?? candidate);
      briefingSessionStore.save(session);
    }).catch(() => {
      // The reading experience remains available when protected memory state cannot be refreshed.
    });
    let selectedItem: HTMLElement | null = null;
    let selectedText = "";
    let activeCandidate: MemoryCandidate | null = null;
		let panelTrigger: HTMLElement | null = null;
		let panelTransition = 0;
		const reducedPanelMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

		if (panel && scrim) {
			gsap.set(panel, { xPercent: 100 });
			gsap.set(scrim, { opacity: 0 });
		}

		const setPanel = (open: boolean, restoreFocus = false) => {
      if (!panel || !scrim) return;
			const transition = ++panelTransition;
			gsap.killTweensOf([panel, scrim]);
      if (open) {
				panel.setAttribute("aria-hidden", "false");
				scrim.hidden = false;
				document.body.classList.add("annotation-open");
				gsap.to(panel, {
					xPercent: 0,
					duration: reducedPanelMotion.matches ? 0 : 0.58,
					ease: "power4.out",
					overwrite: "auto",
					onComplete: () => {
						if (transition !== panelTransition) return;
						form?.querySelector<HTMLTextAreaElement>("textarea")?.focus({ preventScroll: true });
					},
				});
				gsap.to(scrim, { opacity: 1, duration: reducedPanelMotion.matches ? 0 : 0.34, ease: "power2.out" });
			} else {
				gsap.to(panel, {
					xPercent: 100,
					duration: reducedPanelMotion.matches ? 0 : 0.44,
					ease: "power3.in",
					overwrite: "auto",
					onComplete: () => {
						if (transition !== panelTransition) return;
						panel.setAttribute("aria-hidden", "true");
						scrim.hidden = true;
						document.body.classList.remove("annotation-open");
						if (restoreFocus) panelTrigger?.focus({ preventScroll: true });
					},
				});
				gsap.to(scrim, { opacity: 0, duration: reducedPanelMotion.matches ? 0 : 0.3, ease: "power2.in" });
      }
    };

    const hideMenu = () => {
      if (menu) menu.hidden = true;
    };

    const semanticComments: Partial<Record<AnnotationAction, string>> = {
      explain: "请深入解释这段内容，补充它成立的条件、技术机制，以及对 zxlab 的具体影响。",
      challenge: "请质疑这段判断，指出证据缺口、可能的反例、替代解释，以及仍需验证的假设。",
      remember: "我认同并希望记住这段判断。请把它整理成范围明确、可审计的当前看法候选。",
      track: "请把这段内容转成可复核的持续追踪条件，说明未来哪些公开线索值得收集；命中只作为观察，不判断条件已经成立。",
    };

    const openPanel = (action: AnnotationAction) => {
      if (!form || !selectedItem || !selectedText) return;
			panelTrigger = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      form.reset();
      if (submitError) submitError.hidden = true;
      result?.setAttribute("hidden", "");
      if (watchConfirm) watchConfirm.hidden = true;
      if (watchConfirmStatus) watchConfirmStatus.hidden = true;
      if (watchCondition) watchCondition.readOnly = false;
      if (watchConfirmButton) {
        watchConfirmButton.disabled = false;
        const label = watchConfirmButton.querySelector<HTMLElement>("span");
        if (label) label.textContent = "确认追踪";
      }
      activeCandidate = null;
      const itemId = selectedItem.dataset.briefingItem ?? "";
      const itemTitle = selectedItem.dataset.itemTitle ?? "日报条目";
      (form.elements.namedItem("itemId") as HTMLInputElement).value = itemId;
      (form.elements.namedItem("action") as HTMLInputElement).value = action;
      (form.elements.namedItem("selectedText") as HTMLInputElement).value = selectedText;
      const comment = form.elements.namedItem("comment") as HTMLTextAreaElement;
      const semanticComment = semanticComments[action];
      comment.value = semanticComment ?? "";
      comment.readOnly = Boolean(semanticComment);
      if (commentLabel) commentLabel.textContent = semanticComment ? "Signal 将按此意图处理" : "你的判断";
      if (selectionOutput) selectionOutput.textContent = `“${selectedText}”`;
      if (itemOutput) itemOutput.textContent = itemTitle;
      hideMenu();
      setPanel(true);
      if (semanticComment) window.setTimeout(() => form.requestSubmit(), 80);
    };

    const normalizeSelectedText = (value: string) => value.trim().replace(/\s+/g, " ");

    const defaultItemSelection = (item: HTMLElement | null): string => {
      const preferred = item?.querySelector<HTMLElement>(".signal-item__action p")
        ?? item?.querySelector<HTMLElement>("[data-item-analysis]:not([hidden]) [data-selectable-segment] p")
        ?? item?.querySelector<HTMLElement>(".signal-item__summary");
      return normalizeSelectedText(preferred?.textContent ?? "");
    };

    const captureSelection = () => {
      const selection = window.getSelection();
      let text = normalizeSelectedText(selection?.toString() ?? "");
      if (!selection || selection.rangeCount === 0) {
        hideMenu();
        return;
      }
      const range = selection.getRangeAt(0);
      const origin = range.commonAncestorContainer instanceof Element
        ? range.commonAncestorContainer
        : range.commonAncestorContainer.parentElement;
      const body = origin?.closest<HTMLElement>("[data-selectable-copy]");
      const item = body?.closest<HTMLElement>("[data-briefing-item]");
      const segment = origin?.closest<HTMLElement>("[data-selectable-segment]");
      if (!body || !item || !menu) {
        hideMenu();
        return;
      }
      if (text.length < 6 && segment) text = normalizeSelectedText(segment.textContent ?? "");
      if (text.length < 6) {
        hideMenu();
        return;
      }
      selectedItem = item;
      selectedText = text.slice(0, 420);
      const rect = range.getBoundingClientRect();
      menu.hidden = false;
      const left = Math.min(window.innerWidth - menu.offsetWidth - 12, Math.max(12, rect.left + rect.width / 2 - menu.offsetWidth / 2));
      const top = Math.max(12, rect.top - menu.offsetHeight - 12);
      menu.style.transform = `translate3d(${left}px, ${top}px, 0)`;
    };

    document.addEventListener("mouseup", () => window.setTimeout(captureSelection));
    document.addEventListener("selectionchange", () => {
      if (!window.getSelection()?.toString().trim()) hideMenu();
    });
    document.addEventListener("pointerdown", (event) => {
      const target = event.target as Element;
      if (!target.closest("[data-annotation-menu]") && !target.closest("[data-selectable-copy]")) hideMenu();
    });

    menu?.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("[data-action]");
      if (button) openPanel(button.dataset.action as AnnotationAction);
    });

    document.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("[data-mobile-comment]");
      if (button) {
        selectedItem = button.closest<HTMLElement>("[data-briefing-item]");
        selectedText = defaultItemSelection(selectedItem);
        openPanel("comment");
      }
    });

    let selectedCategory = "all";
    let importantOnly = false;
    const categoryFilters = document.querySelectorAll<HTMLButtonElement>("[data-category-filter]");
    const importanceFilter = document.querySelector<HTMLButtonElement>("[data-importance-filter]");
    const visibleCount = document.querySelector<HTMLElement>("[data-visible-count]");
    const filterEmpty = document.querySelector<HTMLElement>("[data-filter-empty]");

    const applyReadingFilters = () => {
      let count = 0;
      document.querySelectorAll<HTMLElement>("[data-briefing-item]").forEach((item) => {
        const matchesCategory = selectedCategory === "all" || item.dataset.itemCategory === selectedCategory;
        const matchesImportance = !importantOnly || Number(item.dataset.itemImportance) >= 85;
        const visible = matchesCategory && matchesImportance;
        item.toggleAttribute("hidden", !visible);
        if (visible) count += 1;
      });
      if (visibleCount) visibleCount.textContent = String(count);
      if (filterEmpty) filterEmpty.hidden = count !== 0;
      ScrollTrigger.refresh();
    };

    categoryFilters.forEach((button) => {
      button.addEventListener("click", () => {
        selectedCategory = button.dataset.categoryFilter ?? "all";
        categoryFilters.forEach((candidate) => {
          candidate.setAttribute("aria-pressed", String(candidate === button));
        });
        applyReadingFilters();
      });
    });

    importanceFilter?.addEventListener("click", () => {
      importantOnly = !importantOnly;
      importanceFilter.setAttribute("aria-pressed", String(importantOnly));
      applyReadingFilters();
    });

    document.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("[data-analysis-toggle]");
      if (button) {
        const item = button.closest<HTMLElement>("[data-briefing-item]");
        const analysis = item?.querySelector<HTMLElement>("[data-item-analysis]");
        if (!analysis) return;
        const willOpen = analysis.hidden;
        analysis.hidden = !willOpen;
        button.setAttribute("aria-expanded", String(willOpen));
        const label = button.querySelector<HTMLElement>("span");
        if (label) label.textContent = willOpen ? "收起分析" : "展开分析";
        if (willOpen) {
          gsap.from(analysis, { y: 12, opacity: 0, duration: 0.45, ease: "power3.out" });
        }
        ScrollTrigger.refresh();
      }
    });

    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;",
    }[character] ?? character));

    const dateLabel = (date: string) => new Intl.DateTimeFormat("zh-CN", {
      month: "long",
      day: "numeric",
      weekday: "long",
      timeZone: "Asia/Shanghai",
    }).format(new Date(`${date}T12:00:00+08:00`));

    const timeLabel = (timestamp: string) => new Intl.DateTimeFormat("zh-CN", {
      hour: "2-digit",
      minute: "2-digit",
      timeZone: "Asia/Shanghai",
    }).format(new Date(timestamp));

    const countLabel = (value: number | null | undefined) => value == null ? "—" : String(value);

    const itemCard = (item: BriefingItem, index: number) => {
      const categoryLabels = { "ai-engineering": "AI Engineering", markets: "Markets", zxlab: "zxlab" } as const;
      const itemType = item.itemType ?? (index === 0 ? "lead" : "brief");
      const isLead = itemType === "lead";
      const lede = item.lede ?? item.summary;
      const nutGraf = item.nutGraf ?? item.whatChanged ?? item.whyItMatters;
      const implications = item.implications ?? item.whyItMatters;
      const imageSeed = { "ai-engineering": "ai-industry-news", markets: "global-markets-news", zxlab: "digital-infrastructure-news" }[item.category];
      const facts = (item.keyFacts ?? []).map((fact) => `<li data-selectable-segment>${escapeHtml(fact)}</li>`).join("");
      const sources = item.sources.map((source) => {
        const href = escapeHtml(source.url);
        const external = source.url.startsWith("http");
        return `<a href="${href}"${external ? ' target="_blank" rel="noreferrer"' : ""}>${escapeHtml(source.publisher ?? source.title)}<span aria-hidden="true">↗</span></a>`;
      }).join("");
      const sourceNav = isLead && item.sources.length > 1 ? `<div class="signal-source-nav"><button type="button" data-source-direction="prev" aria-label="查看上一来源" title="上一来源">←</button><button type="button" data-source-direction="next" aria-label="查看下一来源" title="下一来源">→</button></div>` : "";
      const analysisToggle = isLead ? "" : `<button class="signal-analysis-toggle" type="button" data-analysis-toggle aria-expanded="false"><span>展开分析</span><span aria-hidden="true">⌄</span></button>`;
      const watchNextAttribute = item.watchNext ? ` data-item-watch-condition="${escapeHtml(item.watchNext)}"` : "";
      return `<article class="signal-item signal-item--${itemType}"${isLead ? ' id="lead-story"' : index === 1 ? ' id="briefs-start"' : ""} data-item-type="${itemType}" data-briefing-item="${escapeHtml(item.id)}" data-item-category="${item.category}" data-item-importance="${item.importance}" data-item-title="${escapeHtml(item.title)}"${watchNextAttribute} aria-labelledby="item-${escapeHtml(item.id)}">
        <header class="signal-item__header"><div><p>${isLead ? "主报道" : "短讯"} · ${categoryLabels[item.category]}</p><h3 id="item-${escapeHtml(item.id)}">${escapeHtml(item.title)}${isLead ? `<span class="signal-lead__micro-image" style="--story-image:url(https://picsum.photos/seed/${imageSeed}/480/240)" role="img" aria-label="今日主报道配图"></span>` : ""}</h3></div><div class="signal-item__score" aria-label="重要性 ${item.importance}，置信度 ${item.confidence}"><span>重要 ${item.importance}</span><span>置信 ${item.confidence}</span></div></header>
        <div class="signal-item__body" data-selectable-copy><p class="signal-item__summary" data-selectable-segment>${escapeHtml(lede)}</p><p class="signal-item__nutgraf" data-selectable-segment>${escapeHtml(nutGraf)}</p>${facts ? `<ul class="signal-item__facts" aria-label="关键事实">${facts}</ul>` : ""}<div class="signal-item__analysis" data-item-analysis${isLead ? "" : " hidden"}>${item.broaderContext ? `<div data-selectable-segment><h4>背景</h4><p>${escapeHtml(item.broaderContext)}</p></div>` : ""}<div data-selectable-segment><h4>影响</h4><p>${escapeHtml(implications)}</p></div>${item.counterpoint ? `<div data-selectable-segment><h4>另一面</h4><p>${escapeHtml(item.counterpoint)}</p></div>` : ""}${item.watchNext ? `<div class="signal-item__watch" data-selectable-segment><h4>接下来</h4><p>${escapeHtml(item.watchNext)}</p></div>` : ""}${item.zxlabRelevance ? `<div data-selectable-segment><h4>对 zxlab</h4><p>${escapeHtml(item.zxlabRelevance)}</p></div>` : ""}</div></div>
        <footer class="signal-item__footer"><div class="signal-sources" data-source-carousel><span>来源</span><div data-source-track>${sources}</div>${sourceNav}</div><div class="signal-item__controls">${analysisToggle}<button class="signal-comment-trigger" type="button" data-mobile-comment><span>回应这条</span><span aria-hidden="true">＋</span></button></div></footer>
      </article>`;
    };

    const renderLongTermThreads = (briefing: DailyBriefing) => {
      const resolved = resolveLongTermThreads(briefing.longTermThreads);
      const section = document.querySelector<HTMLElement>("[data-long-term-threads]");
      const label = section?.querySelector<HTMLElement>("[data-default-thread-label]");
      const list = section?.querySelector<HTMLElement>("[data-thread-list]");
      if (!section || !label || !list) return;
      section.dataset.threadOrigin = resolved.usingDefault ? "default" : "generated";
      label.hidden = !resolved.usingDefault;
      list.style.setProperty("--thread-count", String(resolved.threads.length));
      list.innerHTML = resolved.threads.map((thread) => `<article tabindex="0" data-thread-id="${escapeHtml(thread.id)}" data-thread-category="${thread.category}"><div><h3>${escapeHtml(thread.title)}</h3><p>${escapeHtml(thread.description)}</p></div><i aria-hidden="true"></i></article>`).join("");
    };

    const watchTimestamp = (timestamp: string) => {
      const value = new Date(timestamp);
      if (Number.isNaN(value.getTime())) return "时间待确认";
      return new Intl.DateTimeFormat("zh-CN", {
        month: "short",
        day: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        timeZone: "Asia/Shanghai",
      }).format(value);
    };

    const renderWatchWorkspace = () => {
      const content = document.querySelector<HTMLElement>("[data-watch-content]");
      const list = document.querySelector<HTMLElement>("[data-watch-list]");
      const empty = document.querySelector<HTMLElement>("[data-watch-empty]");
      if (!content || !list || !empty) return;

      const ordered = [...watches].sort((left, right) => {
        if (left.status !== right.status) return left.status === "active" ? -1 : 1;
        return new Date(right.updatedAt).getTime() - new Date(left.updatedAt).getTime();
      });
      const active = ordered.filter((watch) => watch.status === "active");
      const resolved = ordered.filter((watch) => watch.status === "resolved");
      const observations = ordered.flatMap((watch) => watch.observations.map((observation) => ({ watch, observation })))
        .sort((left, right) => new Date(right.observation.observedAt).getTime() - new Date(left.observation.observedAt).getTime());
      const latest = observations[0];
      const sourceCount = new Set(observations.flatMap(({ observation }) => observation.sources.map((source) => source.url))).size;
      const mainWatch = active[0] ?? ordered[0];

      const activeCount = document.querySelector<HTMLElement>("[data-watch-active-count]");
      const resolvedCount = document.querySelector<HTMLElement>("[data-watch-resolved-count]");
      const mainCondition = document.querySelector<HTMLElement>("[data-watch-main-condition]");
      const latestTitle = document.querySelector<HTMLElement>("[data-watch-latest-title]");
      const latestCopy = document.querySelector<HTMLElement>("[data-watch-latest-copy]");
      const qualityTitle = document.querySelector<HTMLElement>("[data-watch-quality-title]");
      const qualityCopy = document.querySelector<HTMLElement>("[data-watch-quality-copy]");
      if (activeCount) activeCount.textContent = String(active.length);
      if (resolvedCount) resolvedCount.textContent = String(resolved.length);
      if (mainCondition) mainCondition.textContent = mainWatch?.condition ?? "等待第一个明确的追踪条件";
      if (latestTitle) latestTitle.textContent = latest?.observation.title ?? "暂无新观察";
      if (latestCopy) latestCopy.textContent = latest
        ? `${latest.observation.summary} · ${watchTimestamp(latest.observation.observedAt)}`
        : "创建 Watch 后，最近的跨日证据会出现在这里。";
      if (qualityTitle) qualityTitle.textContent = sourceCount > 0 ? `${sourceCount} 个可核查来源` : "等待可核查来源";
      if (qualityCopy) qualityCopy.textContent = observations.length > 0
        ? `${observations.length} 次观察覆盖 ${ordered.length} 个条件；命中只作为待复核记录，并保留可用来源。`
        : "每条观察都会保留可用的原始来源；主题相似只代表需要复核。";

      const categoryLabels = { "ai-engineering": "AI Engineering", markets: "Markets", zxlab: "zxlab" } as const;
      list.innerHTML = ordered.map((watch, index) => {
        const latestObservation = [...watch.observations].sort((left, right) => new Date(right.observedAt).getTime() - new Date(left.observedAt).getTime())[0];
        const sources = latestObservation?.sources.map((source) => {
          const external = source.url.startsWith("http");
          return `<a href="${escapeHtml(source.url)}"${external ? ' target="_blank" rel="noreferrer"' : ""}>${escapeHtml(source.publisher ?? source.title)}<span aria-hidden="true">↗</span></a>`;
        }).join("") ?? "";
        const panelId = `watch-panel-${index}`;
        return `<article class="signal-watch-card" data-watch-id="${escapeHtml(watch.id)}" data-watch-status="${watch.status}" data-expanded="false">
          <button class="signal-watch-card__toggle" type="button" data-watch-toggle aria-expanded="false" aria-controls="${panelId}">
            <span class="signal-watch-card__status">${watch.status === "active" ? "持续中" : "已结束"} · ${categoryLabels[watch.category]}</span>
            <h3>${escapeHtml(watch.title)}</h3>
            <p>${escapeHtml(watch.condition)}</p>
            <span class="signal-watch-card__prompt">${latestObservation ? `${watch.observations.length} 次观察` : "等待首次观察"}<i aria-hidden="true">→</i></span>
          </button>
          <div class="signal-watch-card__details" id="${panelId}" data-watch-details aria-hidden="true" hidden>
            <div class="signal-watch-card__observation">
              <span>${latestObservation ? watchTimestamp(latestObservation.observedAt) : "尚无观察"}</span>
              <h4>${escapeHtml(latestObservation?.title ?? "等待与条件相关的待复核观察")}</h4>
              <p>${escapeHtml(latestObservation?.summary ?? "命中会保留可用来源，仍需要人工判断它是否相关，以及条件是否成立。")}</p>
            </div>
            <div class="signal-watch-card__sources"><span>原始来源</span><div>${sources || "<p>这次观察还没有可核查来源。</p>"}</div></div>
            <div class="signal-watch-card__meta"><span>建立于 ${watchTimestamp(watch.createdAt)}</span><span>更新于 ${watchTimestamp(watch.updatedAt)}</span></div>
            ${watch.status === "active" ? '<button class="signal-watch-card__resolve" type="button" data-watch-resolve>结束追踪</button>' : `<p class="signal-watch-card__resolved">已于 ${watchTimestamp(watch.resolvedAt ?? watch.updatedAt)} 结束，观察历史仍保留。</p>`}
            <p class="signal-watch-card__action-status" role="status" aria-live="polite" data-watch-action-status hidden></p>
          </div>
        </article>`;
      }).join("");
      empty.hidden = ordered.length !== 0;
      list.hidden = ordered.length === 0;
      content.hidden = false;
      ScrollTrigger.refresh();
    };

    const loadWatchWorkspace = async () => {
      const status = document.querySelector<HTMLElement>("[data-watch-load-status]");
      if (status) {
        status.hidden = false;
        status.textContent = "正在读取跨设备追踪…";
      }
      try {
        watches = await getWatches();
        renderWatchWorkspace();
        if (status) status.hidden = true;
      } catch (error) {
        if (status) status.textContent = error instanceof Error
          ? `跨设备追踪暂时无法读取：${error.message}。日报仍可继续阅读。`
          : "跨设备追踪暂时无法读取，日报仍可继续阅读。";
      }
    };

    const renderBriefing = (briefing: DailyBriefing) => {
      briefingId = briefing.id;
      if (briefingPage) {
        briefingPage.dataset.briefingId = briefing.id;
        briefingPage.dataset.briefingState = briefing.status;
        briefingPage.dataset.briefingGeneratedAt = briefing.generatedAt;
        briefingPage.dataset.briefingQualityStatus = briefing.qualityStatus;
      }
      activeQualityStatus = briefing.qualityStatus;
      document.querySelector<HTMLElement>(".signal-kicker")?.replaceChildren(document.createElement("span"), ` ZX Signal · ${dateLabel(briefing.date)}`);
      const deck = document.querySelector<HTMLElement>(".signal-deck");
      if (deck) deck.textContent = briefing.title;
      const summary = document.querySelector<HTMLElement>("[data-scrub-summary]");
      if (summary) {
        summary.textContent = briefing.summary;
        summary.dataset.expanded = "false";
      }
      const origin = document.querySelector<HTMLElement>("[data-briefing-origin]");
      if (origin) {
        const sourceLabel = { mock: "Mock 预览", fixture: "Fixture", real: "真实候选" }[briefing.dataOrigin];
        const generationLabel = {
          model: "模型综合",
          "deterministic-fallback": "确定性降级",
          "legacy-unknown": "历史生成方式未知",
        }[briefing.generationMode];
        origin.textContent = `${sourceLabel} · ${generationLabel}`;
      }
      const editorialValues = document.querySelectorAll<HTMLElement>(".signal-editorial dl dd");
      if (editorialValues[0]) editorialValues[0].textContent = timeLabel(briefing.generatedAt);
      if (editorialValues[1]) editorialValues[1].textContent = briefing.promptVersion;
      const filterTitle = document.querySelector<HTMLElement>("#filter-title");
      const pipelineStatsKnown = briefing.stats.fetched != null
        && briefing.stats.deduplicated != null
        && briefing.stats.balanced != null;
      if (filterTitle) filterTitle.textContent = pipelineStatsKnown
        ? `采集 ${briefing.stats.fetched} 个信号，去重与均衡后发布 ${briefing.stats.selected} 条。`
        : `本期发布 ${briefing.stats.selected} 条；部分处理阶段统计未记录。`;
      const balancedCount = briefing.stats.balanced;
      const marquee = document.querySelector<HTMLElement>(".signal-filter__marquee > div");
      if (marquee) marquee.innerHTML = `<span>采集 ${countLabel(briefing.stats.fetched)} 条</span><i></i><span>去重后 ${countLabel(briefing.stats.deduplicated)} 条</span><i></i><span>均衡输入 ${countLabel(balancedCount)} 条</span><i></i><span>最终发布 ${briefing.stats.selected} 条</span><i></i><span>采集 ${countLabel(briefing.stats.fetched)} 条</span><i></i><span>去重后 ${countLabel(briefing.stats.deduplicated)} 条</span><i></i><span>均衡输入 ${countLabel(balancedCount)} 条</span><i></i><span>最终发布 ${briefing.stats.selected} 条</span><i></i>`;
      const steps = document.querySelectorAll<HTMLElement>(".signal-filter__steps strong");
      if (steps[0]) steps[0].textContent = countLabel(briefing.stats.fetched);
      if (steps[1]) steps[1].textContent = countLabel(briefing.stats.deduplicated);
      if (steps[2]) steps[2].textContent = countLabel(balancedCount);
      if (steps[3]) steps[3].textContent = String(briefing.stats.selected);
      const partialCount = document.querySelector<HTMLElement>("[data-partial-count]");
      if (partialCount) partialCount.textContent = String(briefing.stats.selected);
      const stream = document.querySelector<HTMLElement>(".signal-stream__items");
      if (stream) {
        stream.querySelectorAll(".signal-item").forEach((item) => item.remove());
        const empty = stream.querySelector<HTMLElement>("[data-filter-empty]");
        empty?.insertAdjacentHTML("beforebegin", briefing.items.map(itemCard).join(""));
        stream.querySelectorAll<HTMLElement>(".signal-item--brief").forEach((item, index) => {
          item.style.setProperty("--brief-stack-index", String(index));
        });
      }
      renderLongTermThreads(briefing);
      setPreviewState(briefing.status);
      applyReadingFilters();
    };

    document.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("[data-source-direction]");
      if (!button) return;
      const track = button.closest<HTMLElement>("[data-source-carousel]")?.querySelector<HTMLElement>("[data-source-track]");
      if (!track) return;
      const direction = button.dataset.sourceDirection === "prev" ? -1 : 1;
      track.scrollBy({ left: direction * Math.max(220, track.clientWidth * 0.72), behavior: "smooth" });
    });

    document.addEventListener("click", (event) => {
      const toggle = (event.target as Element).closest<HTMLButtonElement>("[data-watch-toggle]");
      if (!toggle) return;
      const card = toggle.closest<HTMLElement>("[data-watch-id]");
      const details = card?.querySelector<HTMLElement>("[data-watch-details]");
      const list = card?.closest<HTMLElement>("[data-watch-list]");
      if (!card || !details) return;
      const willOpen = card.dataset.expanded !== "true";
      list?.querySelectorAll<HTMLElement>("[data-watch-id]").forEach((candidate) => {
        const candidateToggle = candidate.querySelector<HTMLButtonElement>("[data-watch-toggle]");
        const candidateDetails = candidate.querySelector<HTMLElement>("[data-watch-details]");
        candidate.dataset.expanded = "false";
        candidateToggle?.setAttribute("aria-expanded", "false");
        candidateDetails?.setAttribute("aria-hidden", "true");
        if (candidateDetails) candidateDetails.hidden = true;
      });
      card.dataset.expanded = String(willOpen);
      toggle.setAttribute("aria-expanded", String(willOpen));
      details.setAttribute("aria-hidden", String(!willOpen));
      details.hidden = !willOpen;
      if (willOpen && !reducedPanelMotion.matches) {
        gsap.from(details, { opacity: 0, x: 12, duration: 0.45, ease: "power3.out" });
      }
      ScrollTrigger.refresh();
    });

    document.addEventListener("click", async (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("[data-watch-resolve]");
      if (!button) return;
      const card = button.closest<HTMLElement>("[data-watch-id]");
      const id = card?.dataset.watchId;
      const status = card?.querySelector<HTMLElement>("[data-watch-action-status]");
      if (!id) return;
      button.disabled = true;
      if (status) {
        status.hidden = false;
        status.textContent = "正在结束追踪…";
      }
      try {
        const resolved = await resolveWatch(id);
        watches = watches.map((watch) => watch.id === resolved.id ? resolved : watch);
        renderWatchWorkspace();
        const resolvedCard = [...document.querySelectorAll<HTMLElement>("[data-watch-id]")]
          .find((candidate) => candidate.dataset.watchId === resolved.id);
        resolvedCard?.querySelector<HTMLButtonElement>("[data-watch-toggle]")?.focus({ preventScroll: true });
        const workspaceStatus = document.querySelector<HTMLElement>("[data-watch-load-status]");
        if (workspaceStatus) {
          workspaceStatus.hidden = false;
          workspaceStatus.textContent = `已结束“${resolved.title}”的追踪，观察历史仍保留。`;
        }
      } catch (error) {
        button.disabled = false;
        if (status) status.textContent = error instanceof Error ? `结束失败：${error.message}` : "结束失败，请重试。";
      }
    });

    if (!previewParam) {
      const initialGeneratedAt = briefingPage?.dataset.briefingGeneratedAt ?? "";
      getLatestBriefing("ready").then((latest) => {
        if (latest.id !== briefingId || latest.generatedAt !== initialGeneratedAt) renderBriefing(latest);
      }).catch(() => {
        // Keep the server-rendered edition when the public latest endpoint cannot be refreshed.
      });
    }
    void loadWatchWorkspace();

    const summaryToggle = document.querySelector<HTMLButtonElement>("[data-summary-toggle]");
    summaryToggle?.addEventListener("click", () => {
      const summary = document.querySelector<HTMLElement>("[data-scrub-summary]");
      if (!summary) return;
      const expanded = summary.dataset.expanded === "true";
      summary.dataset.expanded = String(!expanded);
      summaryToggle.setAttribute("aria-expanded", String(!expanded));
      summaryToggle.textContent = expanded ? "展开摘要" : "收起摘要";
      ScrollTrigger.refresh();
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const values = new FormData(form);
      const comment = String(values.get("comment") ?? "").trim();
      if (!comment) return;
      const action = String(values.get("action")) as AnnotationAction;
      const annotationBriefingId = briefingId;
      const annotationItemId = String(values.get("itemId"));
      const annotationSelectedText = String(values.get("selectedText"));
      const isTrackAction = action === "track";
      const submit = form.querySelector<HTMLButtonElement>("button[type='submit']");
      if (submit) submit.disabled = true;
      if (submitLabel) submitLabel.textContent = "Signal 正在回应";

      const replyContent = document.querySelector<HTMLElement>("[data-reply-content]");
      const memoryBox = document.querySelector<HTMLElement>("[data-memory-candidate]");
      const memoryContent = document.querySelector<HTMLElement>("[data-memory-content]");
      const confidence = document.querySelector<HTMLElement>("[data-memory-confidence]");
      const scope = document.querySelector<HTMLSelectElement>("[data-memory-scope]");
      const memoryStatus = document.querySelector<HTMLElement>("[data-memory-status]");
      if (replyContent) replyContent.textContent = "";
      if (memoryBox) memoryBox.hidden = true;
      if (memoryStatus) memoryStatus.hidden = true;
      if (watchConfirm) watchConfirm.hidden = true;
      if (watchConfirmStatus) watchConfirmStatus.hidden = true;
      result?.removeAttribute("hidden");
      result?.scrollIntoView({ behavior: reducedPanelMotion.matches ? "auto" : "smooth", block: "start" });

      try {
        let finalResponse: AnnotationResponse | null = null;
        let streamedReply = "";
        for await (const streamEvent of submitAnnotationStream({
          briefingId: annotationBriefingId,
          briefingItemId: annotationItemId,
          selectedText: annotationSelectedText,
          comment,
          action,
        })) {
          if (streamEvent.type === "start") {
            if (submitLabel) submitLabel.textContent = "Signal 正在回应";
          } else if (streamEvent.type === "reply_delta") {
            streamedReply += streamEvent.text;
            if (replyContent) replyContent.textContent = streamedReply;
          } else if (streamEvent.type === "reply_reset") {
            streamedReply = "";
            if (replyContent) replyContent.textContent = "";
          } else if (streamEvent.type === "reply") {
            streamedReply = streamEvent.reply.content;
            if (replyContent) replyContent.textContent = streamEvent.reply.content;
            if (submitLabel) submitLabel.textContent = isTrackAction ? "正在整理追踪条件" : "正在整理 Memory";
          } else if (streamEvent.type === "memory") {
            activeCandidate = isTrackAction ? null : streamEvent.memoryCandidate ?? null;
            if (memoryBox) memoryBox.hidden = isTrackAction || !streamEvent.memoryCandidate;
            if (!isTrackAction && streamEvent.memoryCandidate) {
              if (memoryContent) memoryContent.textContent = `“${streamEvent.memoryCandidate.content}”`;
              if (confidence) confidence.textContent = `置信 ${Math.round(streamEvent.memoryCandidate.confidence * 100)}`;
              if (scope) scope.value = streamEvent.memoryCandidate.scope;
            }
          } else if (streamEvent.type === "done") {
            finalResponse = streamEvent.response;
          } else if (streamEvent.type === "error") {
            throw new Error(streamEvent.error.message);
          }
        }
        if (!finalResponse) throw new Error("Signal stream ended before completion");
        const response = finalResponse;
        session.annotations.push(response.annotation);
        session.replies.push(response.reply);
        if (!isTrackAction && response.memoryCandidate) session.memoryCandidates.push(response.memoryCandidate);
        briefingSessionStore.save(session);
        activeCandidate = isTrackAction ? null : response.memoryCandidate ?? null;

        if (replyContent) replyContent.textContent = response.reply.content;
        if (memoryBox) memoryBox.hidden = isTrackAction || !response.memoryCandidate;
        if (!isTrackAction && response.memoryCandidate) {
          if (memoryContent) memoryContent.textContent = `“${response.memoryCandidate.content}”`;
          if (confidence) confidence.textContent = `置信 ${Math.round(response.memoryCandidate.confidence * 100)}`;
          if (scope) scope.value = response.memoryCandidate.scope;
        }
        if (memoryStatus) memoryStatus.hidden = true;
        if (isTrackAction && watchConfirm && watchCondition) {
          const currentItem = [...document.querySelectorAll<HTMLElement>("[data-briefing-item]")]
            .find((item) => item.dataset.briefingItem === annotationItemId) ?? selectedItem;
          const preferredCondition = normalizeSelectedText(
            currentItem?.dataset.itemWatchCondition
              ?? currentItem?.querySelector<HTMLElement>(".signal-item__watch p")?.textContent
              ?? "",
          );
          watchCondition.value = preferredCondition || normalizeSelectedText(annotationSelectedText);
          watchConfirm.dataset.briefingId = annotationBriefingId;
          watchConfirm.dataset.briefingItemId = annotationItemId;
          watchConfirm.hidden = false;
          watchCondition.focus({ preventScroll: true });
        }
        if (submitLabel) submitLabel.textContent = "再次发送";
      } catch (error) {
        if (submitError) {
          submitError.hidden = false;
          submitError.textContent = error instanceof Error
            ? `发送失败：${error.message}。评论内容已保留，可直接重试。`
            : "发送失败，评论内容已保留。";
        }
        if (submitLabel) submitLabel.textContent = "重新发送";
      } finally {
        if (submit) submit.disabled = false;
      }
    });

    watchConfirmButton?.addEventListener("click", async () => {
      const condition = normalizeSelectedText(watchCondition?.value ?? "");
      const seedBriefingId = watchConfirm?.dataset.briefingId ?? "";
      const seedBriefingItemId = watchConfirm?.dataset.briefingItemId ?? "";
      if (!condition || !seedBriefingId || !seedBriefingItemId) {
        if (watchConfirmStatus) {
          watchConfirmStatus.hidden = false;
          watchConfirmStatus.textContent = "请先写清追踪条件，再确认建立 Watch。";
        }
        watchCondition?.focus();
        return;
      }
      watchConfirmButton.disabled = true;
      const label = watchConfirmButton.querySelector<HTMLElement>("span");
      if (label) label.textContent = "正在建立追踪";
      if (watchConfirmStatus) {
        watchConfirmStatus.hidden = false;
        watchConfirmStatus.textContent = "正在把条件保存到跨设备 Watch…";
      }
      try {
        const watch = await createWatch({ briefingId: seedBriefingId, briefingItemId: seedBriefingItemId, condition });
        watches = [watch, ...watches.filter((candidate) => candidate.id !== watch.id)];
        renderWatchWorkspace();
        if (watchCondition) watchCondition.readOnly = true;
        if (label) label.textContent = "已开始追踪";
        if (watchConfirmStatus) watchConfirmStatus.textContent = "已确认。之后的命中会作为待复核观察保留，并附上原始来源。";
        const workspaceStatus = document.querySelector<HTMLElement>("[data-watch-load-status]");
        if (workspaceStatus) {
          workspaceStatus.hidden = false;
          workspaceStatus.textContent = `已开始追踪“${watch.title}”。命中不代表条件已经成立。`;
        }
      } catch (error) {
        watchConfirmButton.disabled = false;
        if (label) label.textContent = "重新确认追踪";
        if (watchConfirmStatus) watchConfirmStatus.textContent = error instanceof Error
          ? `建立失败：${error.message}`
          : "建立失败，请重试。";
      }
    });

    const resolveMemory = async (action: "accept" | "reject") => {
      if (!activeCandidate) return;
      const scope = document.querySelector<HTMLSelectElement>("[data-memory-scope]");
      const status = document.querySelector<HTMLElement>("[data-memory-status]");
      try {
        activeCandidate = await updateMemoryCandidate(
          activeCandidate,
          action,
          scope?.value as MemoryScope,
          scope?.value === "project" ? "zxlab" : undefined,
        );
        const index = session.memoryCandidates.findIndex((candidate) => candidate.id === activeCandidate?.id);
        if (index >= 0) session.memoryCandidates[index] = activeCandidate;
        briefingSessionStore.save(session);
        if (status) {
          status.hidden = false;
          status.textContent = action === "accept"
            ? `已保存，范围：${scope?.selectedOptions[0]?.textContent ?? "当前选择"}。`
            : "已忽略，这条建议不会影响后续日报。";
        }
      } catch (error) {
        if (status) {
          status.hidden = false;
          status.textContent = error instanceof Error ? `操作失败：${error.message}` : "操作失败，请重试。";
        }
      }
    };

    document.querySelector("[data-memory-accept]")?.addEventListener("click", () => void resolveMemory("accept"));
    document.querySelector("[data-memory-reject]")?.addEventListener("click", () => void resolveMemory("reject"));
		closeButton?.addEventListener("pointerdown", () => {
			if (!reducedPanelMotion.matches) gsap.to(closeButton, { scale: 0.9, duration: 0.1, ease: "power2.out" });
		}, { passive: true });
		closeButton?.addEventListener("pointerup", () => {
			if (!reducedPanelMotion.matches) gsap.to(closeButton, { scale: 1, duration: 0.28, ease: "back.out(2)" });
		}, { passive: true });
		closeButton?.addEventListener("click", () => setPanel(false, true));
		scrim?.addEventListener("click", () => setPanel(false, true));
    document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && panel?.getAttribute("aria-hidden") === "false") setPanel(false, true);
    });

    const motion = gsap.matchMedia();
    motion.add("(prefers-reduced-motion: no-preference)", () => {
      gsap.from(".signal-hero__copy > *", {
        y: 20,
        opacity: 0,
        duration: 0.8,
        stagger: 0.06,
        ease: "power3.out",
      });
      gsap.from(".signal-editorial", { y: 20, opacity: 0, duration: 0.85, delay: 0.08, ease: "power3.out" });
      gsap.fromTo(".signal-editorial__visual", { scale: 0.8, opacity: 0.45 }, {
        scale: 1,
        opacity: 1,
        ease: "none",
        scrollTrigger: { trigger: ".signal-hero", start: "top top", end: "bottom 30%", scrub: 0.8 },
      });
      gsap.to(".signal-editorial__visual", {
        opacity: 0.2,
        scale: 0.92,
        ease: "none",
        scrollTrigger: { trigger: ".signal-filter", start: "top 90%", end: "top 40%", scrub: 0.8 },
      });
      gsap.utils.toArray<HTMLElement>(".signal-item, .signal-threads, .signal-watches, .signal-action").forEach((element) => {
        gsap.from(element, {
          y: 24,
          opacity: 0,
          duration: 0.8,
          ease: "power3.out",
          scrollTrigger: { trigger: element, start: "top 88%" },
        });
      });
    });
    motion.add("(min-width: 64.01rem) and (prefers-reduced-motion: no-preference)", () => {
      gsap.utils.toArray<HTMLElement>(".signal-item--brief").forEach((item, index) => {
        gsap.fromTo(item, { y: 72, scale: 0.96 }, {
          y: 0,
          scale: 1,
          ease: "none",
          scrollTrigger: { trigger: item, start: "top 92%", end: "top 64%", scrub: 0.7 },
        });
        item.style.setProperty("--brief-stack-index", String(index));
      });
    });

    window.addEventListener("pagehide", () => motion.revert(), { once: true });
  </script>
</Layout>
