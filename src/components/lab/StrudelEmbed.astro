---
import { createStrudelUrl, STRUDEL_ORIGIN } from "../../lab/strudel/embed";
import { DEFAULT_STRUDEL_PRESET_ID, STRUDEL_PRESETS } from "../../lab/strudel/preset";

const defaultPreset = STRUDEL_PRESETS.find((preset) => preset.id === DEFAULT_STRUDEL_PRESET_ID) ?? STRUDEL_PRESETS[0];
const defaultUrl = createStrudelUrl(defaultPreset.source);
---

<section
  class="strudel-embed"
  data-strudel-embed
  data-default-url={defaultUrl}
  data-default-preset={DEFAULT_STRUDEL_PRESET_ID}
  data-presets={JSON.stringify(STRUDEL_PRESETS.map(({ id, title, bpm, source }) => ({ id, title, bpm, source })))}
  data-state="loading"
  aria-label="Embedded Strudel live coding editor"
>
  <header class="strudel-embed__toolbar">
    <div class="strudel-embed__status">
      <span aria-hidden="true"></span>
      <p>Strudel editor</p>
    </div>
    <div class="strudel-embed__actions" aria-label="Strudel editor actions">
      <button type="button" class="strudel-embed__action--play" data-strudel-play disabled aria-pressed="false">
        <span class="strudel-embed__play-icon" aria-hidden="true"></span><span>Play</span>
      </button>
      <button type="button" data-strudel-stop disabled>
        <span class="strudel-embed__stop-icon" aria-hidden="true"></span><span>Stop</span>
      </button>
      <button type="button" data-strudel-reset>Reset template</button>
      <button type="button" data-strudel-fullscreen aria-pressed="false">Fullscreen</button>
      <a href={defaultUrl} data-strudel-open target="_blank" rel="noreferrer">Open on Strudel<span aria-hidden="true">↗</span></a>
    </div>
    <p class="strudel-embed__feedback" data-strudel-feedback role="status" aria-live="polite">Ready to play</p>
  </header>

  <nav class="strudel-embed__presets" aria-label="Strudel presets">
    <span class="strudel-embed__presets-label">Choose a starting pattern</span>
    <div class="strudel-embed__preset-list">
      {STRUDEL_PRESETS.map((preset) => (
        <button
          type="button"
          class:list={{ "is-active": preset.id === DEFAULT_STRUDEL_PRESET_ID }}
          data-strudel-preset={preset.id}
          aria-pressed={preset.id === DEFAULT_STRUDEL_PRESET_ID ? "true" : "false"}
        >
          <span>{preset.title}</span>
          <small>{preset.bpm} BPM</small>
        </button>
      ))}
    </div>
  </nav>

  <div class="strudel-embed__shell" data-strudel-shell>
    <aside
      class="strudel-visualizer"
      data-strudel-visualizer
      data-preset={defaultPreset.id}
      aria-label="Live audio spectrum visualization"
    >
      <header class="strudel-visualizer__header">
        <span>Live spectrum</span>
        <strong data-strudel-visualizer-state>Waiting for play</strong>
      </header>
      <canvas
        data-strudel-visualizer-canvas
        width="240"
        height="720"
        aria-hidden="true"
      ></canvas>
      <footer class="strudel-visualizer__footer">
        <span data-strudel-visualizer-title>{defaultPreset.title}</span>
        <span><span data-strudel-visualizer-bpm>{defaultPreset.bpm}</span> BPM / Audio FFT</span>
      </footer>
    </aside>

    <div class="strudel-embed__stage" data-strudel-stage>
      <strudel-editor
        class="strudel-embed__editor"
        data-strudel-editor
        code={defaultPreset.source}
      ></strudel-editor>
      <div class="strudel-embed__state" data-strudel-state aria-live="polite">
        <span aria-hidden="true"></span>
        <p data-strudel-state-text tabindex="-1">Loading the Strudel editor.</p>
        <a href={STRUDEL_ORIGIN} target="_blank" rel="noreferrer" hidden data-strudel-fallback>
          Open Strudel directly
        </a>
      </div>
    </div>
  </div>

  <footer class="strudel-embed__hints">
    <p><kbd>Ctrl</kbd>/<kbd>Cmd</kbd> + <kbd>Enter</kbd><span>Run or update</span></p>
    <p><kbd>Ctrl</kbd>/<kbd>Cmd</kbd> + <kbd>.</kbd><span>Stop audio</span></p>
    <p><span aria-hidden="true" class="strudel-embed__audio-dot"></span><span>Audio starts only after your interaction</span></p>
  </footer>
</section>

<script>
  import { createStrudelUrl } from "../../lab/strudel/embed";

  type StrudelEditorApi = {
    evaluate?: (autostart?: boolean) => Promise<void>;
    setCode: (source: string) => void;
    stop?: () => Promise<void>;
  };

  type StrudelEditorElement = HTMLElement & {
    editor?: StrudelEditorApi;
  };

  type StrudelAudioController = {
    output: {
      destinationGain: AudioNode | null;
    };
  };

  document.querySelectorAll<HTMLElement>("[data-strudel-embed]").forEach(async (root) => {
    const defaultUrl = root.dataset.defaultUrl;
    const shell = root.querySelector<HTMLElement>("[data-strudel-shell]");
    const stage = root.querySelector<HTMLElement>("[data-strudel-stage]");
    const editorElement = root.querySelector<StrudelEditorElement>("[data-strudel-editor]");
    const play = root.querySelector<HTMLButtonElement>("[data-strudel-play]");
    const stop = root.querySelector<HTMLButtonElement>("[data-strudel-stop]");
    const feedback = root.querySelector<HTMLElement>("[data-strudel-feedback]");
    const reset = root.querySelector<HTMLButtonElement>("[data-strudel-reset]");
    const fullscreen = root.querySelector<HTMLButtonElement>("[data-strudel-fullscreen]");
    const stateText = root.querySelector<HTMLElement>("[data-strudel-state-text]");
    const fallback = root.querySelector<HTMLAnchorElement>("[data-strudel-fallback]");
    const openLink = root.querySelector<HTMLAnchorElement>("[data-strudel-open]");
    const visualizer = root.querySelector<HTMLElement>("[data-strudel-visualizer]");
    const visualizerCanvas = root.querySelector<HTMLCanvasElement>("[data-strudel-visualizer-canvas]");
    const visualizerBpm = root.querySelector<HTMLElement>("[data-strudel-visualizer-bpm]");
    const visualizerTitle = root.querySelector<HTMLElement>("[data-strudel-visualizer-title]");
    const visualizerState = root.querySelector<HTMLElement>("[data-strudel-visualizer-state]");
    const presetButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-strudel-preset]"));
    const controller = new AbortController();
    let fallbackFullscreen = false;
    let visualizerFrame: number | undefined;
    let analyser: AnalyserNode | null = null;
    let analyserSource: AudioNode | null = null;
    let frequencyData: Float32Array<ArrayBuffer> | null = null;
    let timeData: Float32Array<ArrayBuffer> | null = null;
    let audioContext: AudioContext | null = null;
    let getAudioController: (() => StrudelAudioController) | null = null;
    let initializeAudio: (() => Promise<void>) | null = null;
    let editorReady = false;
    let lastEvaluationError: string | null = null;
    let lastSignalLabel = "";
    let lastReducedFrame = 0;
    let activePresetId = root.dataset.defaultPreset ?? "";
    const previousBodyOverflow = document.body.style.overflow;
    const storageKey = "zxlab:strudel:last-preset";
    const presets = JSON.parse(root.dataset.presets ?? "[]") as Array<{ id: string; title: string; bpm: number; source: string }>;
    const presetMap = new Map(presets.map((preset) => [preset.id, preset.source]));

    if (!defaultUrl || !shell || !stage || !editorElement) return;

    const setState = (state: "loading" | "ready" | "error") => {
      root.dataset.state = state;
      if (stateText) {
        stateText.textContent = state === "loading"
          ? "Loading the Strudel editor."
          : state === "error"
            ? "Strudel could not be loaded inside this page."
            : "Strudel editor ready.";
      }
      if (fallback) fallback.hidden = state !== "error";
    };

    const setSignalLabel = (label: string) => {
      if (!visualizerState || label === lastSignalLabel) return;
      lastSignalLabel = label;
      visualizerState.textContent = label;
      visualizerState.dataset.signal = label === "Live output" ? "live" : "idle";
    };

    const setPlaybackState = (started: boolean, pending = false) => {
      root.dataset.playing = String(started);
      if (play) {
        play.disabled = !editorReady || pending;
        play.setAttribute("aria-pressed", String(started));
      }
      if (stop) stop.disabled = !editorReady || !started;
    };

    const setPlaybackFeedback = (message: string, kind: "idle" | "pending" | "live" | "error" = "idle") => {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.dataset.kind = kind;
    };

    const connectAnalyser = () => {
      if (!audioContext || !getAudioController) return false;
      const source = getAudioController().output.destinationGain;
      if (!source) return false;
      if (source === analyserSource && analyser) return true;

      if (analyserSource && analyser) analyserSource.disconnect(analyser);
      analyser = audioContext.createAnalyser();
      analyser.fftSize = 2048;
      analyser.minDecibels = -96;
      analyser.maxDecibels = -12;
      analyser.smoothingTimeConstant = 0.74;
      source.connect(analyser);
      analyserSource = source;
      frequencyData = new Float32Array(analyser.frequencyBinCount);
      timeData = new Float32Array(analyser.fftSize);
      return true;
    };

    const drawVisualizer = (timestamp: number) => {
      if (!visualizerCanvas) return;
      const context = visualizerCanvas.getContext("2d");
      if (!context) return;

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reducedMotion && timestamp - lastReducedFrame < 100) {
        visualizerFrame = window.requestAnimationFrame(drawVisualizer);
        return;
      }
      lastReducedFrame = timestamp;

      const bounds = visualizerCanvas.getBoundingClientRect();
      const density = Math.min(window.devicePixelRatio || 1, 2);
      const width = Math.max(1, Math.round(bounds.width * density));
      const height = Math.max(1, Math.round(bounds.height * density));
      if (visualizerCanvas.width !== width || visualizerCanvas.height !== height) {
        visualizerCanvas.width = width;
        visualizerCanvas.height = height;
      }

      connectAnalyser();
      const hasAnalyser = Boolean(analyser && frequencyData && timeData && audioContext);
      if (hasAnalyser) {
        analyser!.getFloatFrequencyData(frequencyData!);
        analyser!.getFloatTimeDomainData(timeData!);
      }

      const rms = hasAnalyser
        ? Math.sqrt(timeData!.reduce((sum, sample) => sum + sample * sample, 0) / timeData!.length)
        : 0;
      const isRunning = audioContext?.state === "running";
      setSignalLabel(isRunning ? (rms > 0.0025 ? "Live output" : "Listening") : "Waiting for play");

      const bars = 20;
      const gap = Math.min(3 * density, Math.max(0, width / (bars * 2)));
      const barWidth = Math.max(0.5, (width - gap * (bars - 1)) / bars);

      context.clearRect(0, 0, width, height);
      for (let index = 0; index < bars; index += 1) {
        const ratio = index / Math.max(1, bars - 1);
        const frequency = 34 * Math.pow(360, ratio);
        const bin = hasAnalyser
          ? Math.min(frequencyData!.length - 1, Math.round(frequency * analyser!.fftSize / audioContext!.sampleRate))
          : 0;
        const decibels = hasAnalyser ? frequencyData![bin] : -96;
        const normalized = Math.max(0, Math.min(1, (decibels + 88) / 72));
        const energy = Math.pow(normalized, 1.45);
        const barHeight = Math.max(2 * density, height * energy);
        const x = index * (barWidth + gap);
        const y = height - barHeight;
        const radius = Math.min(barWidth / 2, 6 * density);

        const alpha = 0.2 + energy * 0.8;
        context.fillStyle = `rgba(216,255,115,${alpha})`;
        context.beginPath();
        context.roundRect(x, y, barWidth, barHeight, radius);
        context.fill();
      }

      visualizerFrame = window.requestAnimationFrame(drawVisualizer);
    };

    const updateVisualizer = (presetId: string) => {
      const preset = presets.find((item) => item.id === presetId) ?? presets[0];
      if (!preset) return;
      if (visualizer) visualizer.dataset.preset = preset.id;
      if (visualizerBpm) visualizerBpm.textContent = String(preset.bpm);
      if (visualizerTitle) visualizerTitle.textContent = preset.title;
    };

    const resetEditor = () => {
      editorElement.editor?.stop?.();
      editorElement.editor?.setCode(presetMap.get(activePresetId) ?? presets[0].source);
      setPlaybackState(false);
      setPlaybackFeedback("Ready to play");
      stateText?.focus({ preventScroll: true });
    };

    const setActivePreset = (presetId: string, reset = true) => {
      if (!presetMap.has(presetId)) return;
      activePresetId = presetId;
      window.localStorage.setItem(storageKey, presetId);
      updateVisualizer(presetId);
      if (openLink) openLink.href = createStrudelUrl(presetMap.get(presetId) ?? presets[0].source);
      presetButtons.forEach((button) => {
        const active = button.dataset.strudelPreset === presetId;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
      if (reset) resetEditor();
    };

    const dispose = () => {
      controller.abort();
      window.cancelAnimationFrame(visualizerFrame ?? 0);
      editorElement.editor?.stop?.();
      if (analyserSource && analyser) analyserSource.disconnect(analyser);
      analyser?.disconnect();
      root.classList.remove("strudel-embed--fullscreen");
      document.body.style.overflow = previousBodyOverflow;
    };

    const setFallbackFullscreen = (active: boolean) => {
      fallbackFullscreen = active;
      root.classList.toggle("strudel-embed--fullscreen", active);
      document.body.style.overflow = active ? "hidden" : previousBodyOverflow;
      if (fullscreen) {
        fullscreen.textContent = active ? "Exit fullscreen" : "Fullscreen";
        fullscreen.setAttribute("aria-pressed", String(active));
      }
    };

    reset?.addEventListener("click", resetEditor, { signal: controller.signal });
    play?.addEventListener("click", async () => {
      if (!editorElement.editor?.evaluate || !initializeAudio) return;
      lastEvaluationError = null;
      setPlaybackState(false, true);
      setPlaybackFeedback("Starting audio...", "pending");
      try {
        const resumeAudio = audioContext?.state === "suspended" ? audioContext.resume() : Promise.resolve();
        await Promise.all([initializeAudio(), resumeAudio]);
        await editorElement.editor.evaluate(true);
        if (root.dataset.playing !== "true" && !lastEvaluationError) {
          await new Promise((resolve) => window.setTimeout(resolve, 120));
          await editorElement.editor.evaluate(true);
        }
      } catch (error) {
        const message = error instanceof Error ? error.message : "Audio could not start.";
        lastEvaluationError = message;
        setPlaybackFeedback(message, "error");
      } finally {
        setPlaybackState(root.dataset.playing === "true");
      }
    }, { signal: controller.signal });
    stop?.addEventListener("click", async () => {
      await editorElement.editor?.stop?.();
      setPlaybackState(false);
      setPlaybackFeedback("Stopped");
    }, { signal: controller.signal });
    editorElement.addEventListener("update", (event) => {
      const detail = (event as CustomEvent<{ started?: boolean; pending?: boolean; error?: Error }>).detail;
      setPlaybackState(Boolean(detail?.started), Boolean(detail?.pending));
      if (detail?.error) {
        lastEvaluationError = detail.error.message || "The pattern could not be evaluated.";
        setPlaybackFeedback(lastEvaluationError, "error");
      } else if (detail?.pending) {
        setPlaybackFeedback("Evaluating pattern...", "pending");
      } else if (detail?.started) {
        setPlaybackFeedback("Playing", "live");
      }
    }, { signal: controller.signal });
    presetButtons.forEach((button) => {
      button.addEventListener("click", () => setActivePreset(button.dataset.strudelPreset ?? ""), { signal: controller.signal });
    });
    fullscreen?.addEventListener("click", async () => {
      if (fallbackFullscreen) {
        setFallbackFullscreen(false);
        return;
      }
      if (document.fullscreenElement === shell) {
        await document.exitFullscreen();
        return;
      }
      if (document.fullscreenEnabled) {
        try {
          await shell.requestFullscreen();
          return;
        } catch {}
      }
      setFallbackFullscreen(true);
    }, { signal: controller.signal });
    document.addEventListener("fullscreenchange", () => {
      if (fullscreen && !fallbackFullscreen) {
        const active = document.fullscreenElement === shell;
        fullscreen.textContent = active ? "Exit fullscreen" : "Fullscreen";
        fullscreen.setAttribute("aria-pressed", String(active));
      }
    }, { signal: controller.signal });
    window.addEventListener("pagehide", dispose, { once: true });
    document.addEventListener("astro:before-swap", dispose, { once: true });
    const storedPreset = window.localStorage.getItem(storageKey);
    if (storedPreset && presetMap.has(storedPreset)) {
      activePresetId = storedPreset;
      presetButtons.forEach((button) => {
        const active = button.dataset.strudelPreset === activePresetId;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
    }

    setState("loading");
    try {
      const [, audioModule] = await Promise.all([
        import("@strudel/repl/repl-component.mjs"),
        import("@strudel/webaudio"),
      ]);
      await customElements.whenDefined("strudel-editor");
      audioContext = audioModule.getAudioContext();
      getAudioController = audioModule.getSuperdoughAudioController as () => StrudelAudioController;
      initializeAudio = audioModule.initAudio;
      const editorSurface = editorElement.nextElementSibling;
      if (editorSurface && editorSurface !== root.querySelector("[data-strudel-state]")) {
        editorSurface.classList.add("strudel-embed__editor-surface");
      }
      resetEditor();
      editorReady = true;
      setPlaybackState(false);
      setState("ready");
    } catch (error) {
      console.error("Failed to initialize the embedded Strudel runtime.", error);
      setState("error");
      return;
    }

    updateVisualizer(activePresetId);
    visualizerFrame = window.requestAnimationFrame(drawVisualizer);
  });
</script>
