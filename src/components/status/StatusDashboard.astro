---
import CodexUsagePanel from "./CodexUsagePanel.astro";
import LLMGatewayPanel from "./LLMGatewayPanel.astro";
import StatusState from "./StatusState.astro";

const emptyUsage = {
  status: "offline" as const,
  updatedAt: new Date(0).toISOString(),
  limits: [],
  tokenSummary: { lifetimeTokens: null, todayTokens: null, peakDailyTokens: null, currentStreakDays: null, longestStreakDays: null },
  dailyUsage: [],
};
---
<div class="status-dashboard" data-status-dashboard data-overall-state="unknown" data-stale="true">
  <section class="status-overall" aria-labelledby="overall-title" aria-live="polite">
    <div>
      <span class="status-indicator" data-status-indicator="overall" data-state="unknown"><span aria-hidden="true"></span><span data-indicator-label>Connecting</span></span>
      <h2 id="overall-title" data-overall-label>Connecting to Runtime.</h2>
      <p data-overall-message>Retrieving the latest privacy-filtered service snapshot.</p>
    </div>
    <dl>
      <div><dt>Source</dt><dd data-source-label>Runtime control plane</dd></div>
      <div><dt>Freshness</dt><dd data-freshness>Waiting for first snapshot</dd></div>
      <div><dt>Updated</dt><dd><time data-updated-at>Unavailable</time></dd></div>
    </dl>
    <button class="status-refresh" type="button" data-status-refresh><span>Refresh status</span><span aria-hidden="true">↻</span></button>
  </section>

  <div class="status-module-grid" data-module-list>
    <section class="status-module status-runtime" data-status-module="runtime" data-module-state="loading">
      <header><div><p>Core service plane</p><h2>Runtime</h2></div><span data-module-source>Live probes</span></header>
      <div class="runtime-module-body" data-module-body><StatusState hidden={false} title="Connecting to Runtime" message="Collecting verified service probes." /></div>
    </section>
    <section class="status-module status-memory" data-status-module="memory" data-module-state="loading">
      <header><div><p>Canonical context</p><h2>Memory</h2></div><span data-module-source>Signal D1</span></header>
      <div class="runtime-module-body" data-module-body>
        <StatusState hidden={false} title="Connecting to Memory" message="Reading the public Memory counters." />
        <div class="memory-ready" data-memory-ready hidden>
          <div data-memory-summary></div>
          <button class="memory-access-button" type="button" data-memory-access>View Memory</button>
          <div class="memory-private" data-memory-private hidden aria-live="polite"></div>
        </div>
      </div>
    </section>
    <section class="status-module status-agents" data-status-module="agents" data-module-state="loading">
      <header><div><p>Privacy-filtered pulse</p><h2>Device</h2></div><span data-module-source>Runtime + Tailscale</span></header>
      <div class="runtime-module-body" data-module-body><StatusState hidden={false} title="Locating devices" message="Reading allowlisted server and client presence." /></div>
    </section>
    <section class="status-module status-usage" data-status-module="usage" data-module-state="loading">
      <header><div><p>Codex account telemetry</p><h2>Usage</h2></div><span data-module-source>Private collector</span></header>
      <div class="runtime-module-body status-usage-body" data-module-body>
        <StatusState hidden={false} title="Loading usage" message="Collecting live limits and Token history." />
        <div data-usage-ready hidden><CodexUsagePanel usage={emptyUsage} /></div>
      </div>
    </section>
  </div>

  <LLMGatewayPanel />

  <section class="status-module status-activity" data-status-module="activity">
    <header><div><p>Observed transitions</p><h2>Latest activity</h2></div><span>Runtime history</span></header>
    <ol class="activity-list" data-activity-list><li><div><span>Connecting</span><time>Now</time></div><h3>Waiting for the first recorded transition.</h3></li></ol>
  </section>
</div>
