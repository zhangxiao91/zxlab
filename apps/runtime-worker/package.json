{
  "name": "runtime-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8790",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply zx-runtime --local",
    "db:migrate:remote": "wrangler d1 migrations apply zx-runtime --remote"
  },
  "dependencies": {
    "@zxlab/runtime-schema": "0.1.0",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.112.0"
  }
}
