{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "zx-signal",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zx-signal",
      "database_id": "2968cf60-f38f-4488-8a83-2479d4ba3ee2",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["30 23 * * *", "45 23 * * *", "0 0 * * *"]
  },
  "routes": [
    { "pattern": "signal-api.zx-dx.xyz", "custom_domain": true }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "ZX_SIGNAL_LLM_API_URL": "https://beta.zxlab.pages.dev/api/ai/stream",
    "ZX_SIGNAL_LLM_LABEL": "zxlab-project-gateway",
    "ZX_SIGNAL_USER_AGENT": "zxlab-signal/0.2 (+https://zx-dx.xyz)",
    "ZX_SIGNAL_ALLOWED_ORIGINS": "https://zx-dx.xyz,https://zxlab.pages.dev,https://*.zxlab.pages.dev,http://localhost:4321",
    "ZX_SIGNAL_ACCESS_ENABLED": "true",
    "ZX_SIGNAL_SCHEDULE_ENABLED": "true",
    "ZX_SIGNAL_MARKET_NEWS_URL": "https://zxlab-risk-market.zhangxiao9118.workers.dev/api/market/news",
    "CF_ACCESS_TEAM_DOMAIN": "https://zxdx1.cloudflareaccess.com",
    "CF_ACCESS_AUD": "7559429b1da91fe218c27db2cdee8c70cec97195d9b86a0effea1b1916f84e64"
  },
  "secrets": {
    "required": ["ZX_SIGNAL_WRITE_TOKEN", "ZX_MEMORY_BRIDGE_TOKEN", "ZX_RUNTIME_SERVICE_TOKEN", "MARKET_AGENT_MEMORY_TOKEN"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "preview": {
      "name": "zx-signal-preview",
      "compatibility_date": "2026-08-22",
      "compatibility_flags": ["nodejs_compat"],
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zx-signal-preview",
          "database_id": "ff23b0e4-e275-4c2b-b03e-e683805c605c",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": {
        "crons": []
      },
      "vars": {
        "ENVIRONMENT": "development",
        "ZX_SIGNAL_LLM_API_URL": "https://beta.zxlab.pages.dev/api/ai/stream",
        "ZX_SIGNAL_LLM_LABEL": "zxlab-project-gateway-preview",
        "ZX_SIGNAL_USER_AGENT": "zxlab-signal-preview/0.2 (+https://zx-dx.xyz)",
        "ZX_SIGNAL_ALLOWED_ORIGINS": "https://beta.zxlab.pages.dev,https://*.zxlab.pages.dev,http://localhost:4321",
        "ZX_SIGNAL_ACCESS_ENABLED": "false",
        "ZX_SIGNAL_SCHEDULE_ENABLED": "false",
        "ZX_SIGNAL_MARKET_NEWS_URL": "",
        "CF_ACCESS_TEAM_DOMAIN": "",
        "CF_ACCESS_AUD": ""
      },
      "secrets": {
        "required": ["ZX_SIGNAL_PREVIEW_SERVICE_TOKEN", "ZX_SIGNAL_WRITE_TOKEN", "PAGES_DEPLOY_HOOK_URL"]
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      }
    }
  }
}
